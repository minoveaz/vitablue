{
  "name": "vitablue-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node post_build_cleanup.cjs",
    "preview": "vite preview",
    "dev:render-worker": "cd packages/video-studio && tsx src/render-worker.ts",
    "sync-blog": "node scripts/sync_blog.cjs",
    "audit:front": "node scripts/audit_front.cjs",
    "audit:components": "node scripts/audit_component_usage.cjs",
    "audit:components:json": "node scripts/audit_component_usage.cjs --format=json",
    "audit:components:ci": "node scripts/audit_component_usage.cjs --format=json --fail-under=90",
    "validate": "node scripts/audit_front.cjs && node scripts/validate_routes.cjs && node scripts/validate_sitemap.cjs && node scripts/validate_route_registry.cjs",
    "validate-routes": "node scripts/validate_routes.cjs",
    "validate-routes:strict": "node scripts/validate_routes.cjs --strict",
    "validate-sitemap": "node scripts/validate_sitemap.cjs",
    "generate-sitemap": "node scripts/generate_sitemap.cjs --write",
    "generate-sitemap:check": "node scripts/generate_sitemap.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:encoding": "node scripts/check_encoding.cjs",
    "validate-products": "node scripts/validate_product_inventory.cjs",
    "validate-route-registry": "node scripts/validate_route_registry.cjs",
    "test": "vitest run --exclude 'e2e/**'",
    "test:rls": "node scripts/test_rls_matrix.cjs",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile --project=mobile-compact",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:seo": "playwright test e2e/seo.audit.spec.ts --project=desktop",
    "test:e2e:responsive": "playwright test e2e/responsive.diagnostic.spec.ts",
    "audit:lh": "npx unlighthouse --site http://localhost:4173",
    "audit:lh:ci": "npx unlighthouse-ci --site http://localhost:4173 --no-cache"
  },
  "dependencies": {
    "@remotion/player": "4.0.228",
    "@supabase/supabase-js": "^2.112.0",
    "framer-motion": "11.15.0",
    "html-to-image": "^1.11.13",
    "konva": "^10.3.1",
    "lucide-react": "^0.562.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-easy-crop": "^6.2.3",
    "react-helmet-async": "^2.0.5",
    "react-konva": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "undraw-svg": "^2.0.0",
    "url": "^0.11.4",
    "vite-plugin-prerender": "^1.0.8",
    "vite-plugin-sitemap": "^0.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "^4.0.228",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@unlighthouse/cli": "^0.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.66.0",
    "unlighthouse": "^0.18.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
