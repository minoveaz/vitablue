# Supabase Database Settings (required; use the local LoopDev project values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LinkedIn API OAuth Credentials
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here

# Meta Developer OAuth Credentials (Facebook & Instagram)
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# X (Twitter) Developer API Credentials
VITE_X_API_KEY=your_x_api_key_here

# Google Developer Console Credentials (YouTube API)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Server-only OAuth secrets
# Configure these with `supabase secrets set` for Edge Functions.
# Never prefix them with VITE_ and never expose them to the browser.
# LINKEDIN_CLIENT_SECRET=configure-in-supabase
# FACEBOOK_APP_SECRET=configure-in-supabase
# X_API_SECRET=configure-in-supabase
# GOOGLE_CLIENT_SECRET=configure-in-supabase
VITE_PUBLIC_SITE_URL=https://www.vitablue.es

# Phase 5 rollout: persist Image Studio drafts as CreativeDocument v1.
# Set to false to keep the legacy imageStudio envelope for rollback.
# VITE_CREATIVE_DOCUMENT_IMAGE_MIGRATION=false

# Phase 5 rollout: use CreativeDocument v1 for Video Studio runtime and saves.
# Set to false to keep the legacy videoStudio envelope and renderer input.
# VITE_CREATIVE_DOCUMENT_VIDEO_MIGRATION=false
