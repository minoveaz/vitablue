# Caching de Recursos Estáticos en el Navegador (PageSpeed Performance)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Vite assets (Cacheados con hashes en el nombre)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Imágenes y vectores
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fuentes Web
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Forzar Cache-Control de 1 año en recursos estáticos y archivos de tipografías/imágenes
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|webp|svg|woff|woff2|otf|ttf)$">
    Header set Cache-Control "max-age=31536000, public, no-transform"
  </FilesMatch>
  
  # Evitar almacenamiento en caché del HTML principal (para que los usuarios vean cambios de inmediato)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Las rutas privadas usan el index.html de la SPA; el header evita su indexación
  # incluso antes de que React monte su meta robots.
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=VITABLUE_PRIVATE_ROUTE
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^(?:login|backoffice|wizard|resultados)(?:/|$) - [E=VITABLUE_PRIVATE_ROUTE:1]

  # ----------------------------------------------------------------------
  # 1. NORMALIZACIÓN DE DOBLES BARRAS CONSECUTIVAS (// -> /)
  # Evita que Googlebot indexe URLs duplicadas con doble slash.
  # ----------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} //
  RewriteRule ^(.*)$ https://www.vitablue.es/$1 [R=301,L,NE]

  # ----------------------------------------------------------------------
  # 2. CANONICALIZACIÓN EN 1 SOLO SALTO 301 (HTTP / SIN-WWW -> HTTPS + WWW + /)
  # Previene cadenas de redirección múltiples que provocan "Error de redirección".
  # ----------------------------------------------------------------------
  # 2a. Si piden /index.html directo -> https://www.vitablue.es/
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html [NC,OR]
  RewriteCond %{REQUEST_URI} ^/index\.html$ [NC]
  RewriteRule ^index\.html$ https://www.vitablue.es/ [R=301,L,NE]

  # 2b. HTTP o sin-www sin barra final y sin extensión -> HTTPS + www + barra final en 1 solo salto
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteRule ^(.*)$ https://www.vitablue.es/$1/ [R=301,L,NE]

  # 2c. HTTP o sin-www para URLs que ya tienen barra final o archivos con extensión
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.vitablue.es%{REQUEST_URI} [R=301,L,NE]

  # ----------------------------------------------------------------------
  # 3. ALIASES LEGACY DE MARKETING STUDIO & BACKOFFICE (URLS ABSOLUTAS)
  # ----------------------------------------------------------------------
  RewriteRule ^marketing-studio/login$ https://www.vitablue.es/login/ [R=301,L,NE]
  RewriteRule ^marketing-studio/identidad-de-marca$ https://www.vitablue.es/backoffice/marketing-studio/identidad-de-marca/ [R=301,L,NE]
  RewriteRule ^marketing-studio/perfiles-sociales$ https://www.vitablue.es/backoffice/marketing-studio/perfiles-sociales/ [R=301,L,NE]
  RewriteRule ^marketing-studio/campanas(?:/.*)?$ https://www.vitablue.es/backoffice/marketing-studio/campanas/ [R=301,L,NE]
  RewriteRule ^marketing-studio/conexiones$ https://www.vitablue.es/backoffice/marketing-studio/conexiones/ [R=301,L,NE]
  RewriteRule ^marketing-studio/assets$ https://www.vitablue.es/backoffice/marketing-studio/assets/ [R=301,L,NE]
  RewriteRule ^marketing-studio/enlaces$ https://www.vitablue.es/backoffice/marketing-studio/enlaces/ [R=301,L,NE]
  RewriteRule ^marketing-studio/generador-contenido$ https://www.vitablue.es/backoffice/marketing-studio/generador-contenido/ [R=301,L,NE]
  RewriteRule ^marketing-studio/?$ https://www.vitablue.es/backoffice/marketing-studio/ [R=301,L,NE]
  RewriteRule ^backoffice/document-intelligence$ https://www.vitablue.es/backoffice/tools/document-intelligence/ [R=301,L,NE]

  # ----------------------------------------------------------------------
  # 4. REDIRECCIONES DE PRODUCTOS Y RUTAS LEGACY DE PAÍSES / CIUDADES
  # ----------------------------------------------------------------------
  RewriteRule ^estudiantes/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/ [R=301,L,NE]
  RewriteRule ^cotizador\.html/?$ https://www.vitablue.es/wizard/ [R=301,L,NE]

  # Rutas legacy de países (antiguas campañas de visado)
  RewriteRule ^seguro-medico-visado-espana/colombia-bogota/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/colombia/ [R=301,L,NE]
  RewriteRule ^seguro-medico-visado-espana/mexico-cdmx/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/mexico/ [R=301,L,NE]
  RewriteRule ^seguro-medico-visado-espana/peru-lima/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/peru/ [R=301,L,NE]
  RewriteRule ^seguro-medico-visado-espana/argentina-buenos-aires/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/argentina/ [R=301,L,NE]
  RewriteRule ^seguro-medico-visado-espana/ecuador-quito-guayaquil/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/ecuador/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguro-medico-estudiantes/colombia-bogota/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/colombia/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguro-medico-estudiantes/mexico-cdmx/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/mexico/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguro-medico-estudiantes/peru-lima/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/peru/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguro-medico-estudiantes/argentina-buenos-aires/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/argentina/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguro-medico-estudiantes/ecuador-quito-guayaquil/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/ecuador/ [R=301,L,NE]
  
  # Rutas legacy de ciudades
  RewriteRule ^seguro-medico-estudiantes/madrid/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/madrid/ [R=301,L,NE]
  RewriteRule ^seguro-medico-estudiantes/barcelona/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/barcelona/ [R=301,L,NE]
  RewriteRule ^seguro-medico-estudiantes/valencia/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/valencia/ [R=301,L,NE]
  RewriteRule ^seguro-medico-estudiantes/malaga/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/malaga/ [R=301,L,NE]

  # ----------------------------------------------------------------------
  # 5. REDIRECCIONES PERMANENTES DE ARCHIVOS .HTML LEGACY
  # ----------------------------------------------------------------------
  RewriteRule ^productos/seguros-salud/seguros-sanitas/sanitas-mas-salud\.html/?$ https://www.vitablue.es/productos/seguros-salud/seguros-sanitas/sanitas-mas-salud/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguros-sanitas/sanitas-mascotas\.html/?$ https://www.vitablue.es/productos/seguro-mascotas/sanitas-mascotas/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguros-sanitas/asistencia-familiar-iplus\.html/?$ https://www.vitablue.es/productos/seguro-para-decesos/asistencia-familiar/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguros-sanitas/seguro-medico-estudiantes-extranjeros-espana\.html/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/ [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/sanitas-mas-salud/?$ https://www.vitablue.es/productos/seguros-salud/seguros-sanitas/sanitas-mas-salud/ [R=301,L,NE]
  RewriteRule ^productos/seguro-medico-estudiantes-extranjeros-espana\.html/?$ https://www.vitablue.es/productos/seguros-salud/seguro-medico-estudiantes/ [R=301,L,NE]
  RewriteRule ^productos/international-students\.html/?$ https://www.vitablue.es/productos/seguros-salud/seguros-sanitas/international-students/ [R=301,L,NE]
  RewriteRule ^seguros-salud/?$ https://www.vitablue.es/productos/seguros-salud/ [R=301,L,NE]
  RewriteRule ^productos/seguro-de-salud\.html/?$ https://www.vitablue.es/productos/seguros-salud/ [R=301,L,NE]
  RewriteRule ^seguro-expatriados/?$ https://www.vitablue.es/productos/seguros-salud/seguro-expatriados/ [R=301,L,NE]
  RewriteRule ^productos/seguro-medico-expatriados\.html/?$ https://www.vitablue.es/productos/seguros-salud/seguro-expatriados/ [R=301,L,NE]
  RewriteRule ^seguro-nomadas/?$ https://www.vitablue.es/productos/seguros-salud/seguro-nomadas-digitales/ [R=301,L,NE]
  RewriteRule ^productos/seguro-nomadas-digitales\.html/?$ https://www.vitablue.es/productos/seguros-salud/seguro-nomadas-digitales/ [R=301,L,NE]
  RewriteRule ^productos/sanitas-mas-salud\.html/?$ https://www.vitablue.es/productos/seguros-salud/seguros-sanitas/sanitas-mas-salud/ [R=301,L,NE]
  RewriteRule ^productos/sanitas-mascotas\.html/?$ https://www.vitablue.es/productos/seguro-mascotas/sanitas-mascotas/ [R=301,L,NE]
  RewriteRule ^productos/asistencia-familiar-iplus\.html/?$ https://www.vitablue.es/productos/seguro-para-decesos/asistencia-familiar/ [R=301,L,NE]
  RewriteRule ^privacidad\.html/?$ https://www.vitablue.es/privacidad/ [R=301,L,NE]
  RewriteRule ^politica-cookies\.html/?$ https://www.vitablue.es/politica-cookies/ [R=301,L,NE]

  # ----------------------------------------------------------------------
  # 6. CANONICAL TRAILING SLASH PARA RUTAS VIRTUALES (1 SOLO SALTO DIRECTO)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ https://www.vitablue.es/$1/ [R=301,L,NE]

  # ----------------------------------------------------------------------
  # 7. SERVIR ARCHIVOS / DIRECTORIOS FÍSICOS (SSG & STATIC ASSETS)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # 8. SPA FALLBACK (RUTAS DINÁMICAS REACT ROUTER)
  # ----------------------------------------------------------------------
  RewriteRule . /index.html [L]
</IfModule>
