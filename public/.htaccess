# Caching de Recursos Estáticos en el Navegador (PageSpeed Performance)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Vite assets (Cacheados con hashes en el nombre)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Imágenes y vectores
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fuentes Web
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Forzar Cache-Control de 1 año en recursos estáticos y archivos de tipografías/imágenes
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|webp|svg|woff|woff2|otf|ttf)$">
    Header set Cache-Control "max-age=31536000, public, no-transform"
  </FilesMatch>
  
  # Evitar almacenamiento en caché del HTML principal (para que los usuarios vean cambios de inmediato)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirecciones permanentes de URLs legacy hacia sus canónicas.
  RewriteRule ^productos/seguros-salud/seguros-sanitas/sanitas-mas-salud\.html$ /productos/seguros-salud/seguros-sanitas/sanitas-mas-salud [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguros-sanitas/sanitas-mascotas\.html$ /productos/seguro-mascotas/sanitas-mascotas [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguros-sanitas/asistencia-familiar-iplus\.html$ /productos/seguro-para-decesos/asistencia-familiar [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/seguros-sanitas/seguro-medico-estudiantes-extranjeros-espana\.html$ /productos/seguros-salud/seguros-sanitas/international-students [R=301,L,NE]
  RewriteRule ^productos/seguros-salud/sanitas-mas-salud$ /productos/seguros-salud/seguros-sanitas/sanitas-mas-salud [R=301,L,NE]
  RewriteRule ^productos/seguro-medico-estudiantes-extranjeros-espana\.html$ /productos/seguros-salud/seguros-sanitas/international-students [R=301,L,NE]
  RewriteRule ^productos/international-students\.html$ /productos/seguros-salud/seguros-sanitas/international-students [R=301,L,NE]
  RewriteRule ^seguros-salud$ /productos/seguros-salud [R=301,L,NE]
  RewriteRule ^productos/seguro-de-salud\.html$ /productos/seguros-salud [R=301,L,NE]
  RewriteRule ^seguro-expatriados$ /productos/seguros-salud/seguro-expatriados [R=301,L,NE]
  RewriteRule ^productos/seguro-medico-expatriados\.html$ /productos/seguros-salud/seguro-expatriados [R=301,L,NE]
  RewriteRule ^seguro-nomadas$ /productos/seguros-salud/seguro-nomadas-digitales [R=301,L,NE]
  RewriteRule ^productos/seguro-nomadas-digitales\.html$ /productos/seguros-salud/seguro-nomadas-digitales [R=301,L,NE]
  RewriteRule ^productos/sanitas-mas-salud\.html$ /productos/seguros-salud/seguros-sanitas/sanitas-mas-salud [R=301,L,NE]
  RewriteRule ^productos/sanitas-mascotas\.html$ /productos/seguro-mascotas/sanitas-mascotas [R=301,L,NE]
  RewriteRule ^productos/asistencia-familiar-iplus\.html$ /productos/seguro-para-decesos/asistencia-familiar [R=301,L,NE]
  RewriteRule ^privacidad\.html$ /privacidad [R=301,L,NE]
  RewriteRule ^politica-cookies\.html$ /politica-cookies [R=301,L,NE]
  
  # Si el archivo o directorio físico solicitado existe, servirlo directamente (SEO & SSG)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback a index.html para rutas virtuales manejadas por React Router (SPA Fallback)
  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>
